# Local Claude Code state stays private, but the smoke-tester agent, the
# project SessionStart hook, and the skills travel with the repo.
.claude/*
!.claude/agents/
!.claude/hooks/
!.claude/skills/
!.claude/settings.json
.claude/settings.local.json

# Figma atlas shoot output (swapped into Figma as fills, never committed)
atlas-shots/

# Node + smoke-test artifacts
node_modules/
test/screenshots/
test-results/
playwright-report/

# Flows generated by `FLOW_WRITE=1 npm run flow` are throwaway; only real games
# sent in from the sideline get committed to flows/ as the regression corpus.
flows/generated/
test/tmp-*.mjs
screen-audit.json
palette-mock.html
app-*.html
